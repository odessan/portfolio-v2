---
import type { CollectionEntry } from "astro:content";
import Blob from "./Blob.astro";
import { disciplines } from "../lib/disciplines";

type Props = { project: CollectionEntry<"projects">; headingLevel?: "h2" | "h3" };
const { project, headingLevel: H = "h3" } = Astro.props;
const { title, summary, disciplines: ds, cover } = project.data;
const seed = [...project.id].reduce((a, c) => a + c.charCodeAt(0), 0);
---

<a
  href={`/work/${project.id}`}
  class="project-card group flex flex-col gap-5 rounded-card"
  data-disciplines={ds.join(" ")}
>
  <div class="preview relative grid aspect-16/10 place-items-center overflow-hidden rounded-card bg-off-black">
    {
      cover ? (
        <img
          src={cover}
          alt=""
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-500 ease-out-expo group-hover:scale-[1.03]"
        />
      ) : (
        <Blob
          discipline={ds[0]}
          seed={seed}
          class="w-[62%] scale-105 transition-transform duration-500 ease-out-expo group-hover:scale-[1.1]"
        />
      )
    }
  </div>
  <div class="flex flex-col gap-2">
    <p class="flex flex-wrap gap-x-3 text-body-sm">
      {ds.map((d) => <span style={{ color: disciplines[d].color }}>{disciplines[d].label}</span>)}
    </p>
    <H class="text-[24px] leading-tight font-semibold tracking-[-0.01em] decoration-1 underline-offset-[5px] group-hover:underline">
      {title}
    </H>
    <p class="text-body-sm text-muted">{summary}</p>
  </div>
</a>
