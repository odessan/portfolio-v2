---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { href: string; variant?: "ghost" | "gradient" };
const { variant = "ghost", href, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    "pill inline-flex min-h-11 items-center justify-center gap-2 rounded-pill px-6 py-3.75 text-[18px] leading-[1.05] font-semibold whitespace-nowrap text-cream transition-[border-color] duration-300",
    variant === "gradient" ? "pill-gradient" : "border border-cream hover:border-cream/60",
    className,
  ]}
  {...rest}
>
  <slot />
</a>

<style>
  .pill-gradient {
    border: 1.5px solid transparent;
    background:
      linear-gradient(var(--color-just-black), var(--color-just-black)) padding-box,
      var(--gradient-green) border-box;
  }
  .pill-gradient:hover {
    background:
      linear-gradient(color-mix(in srgb, var(--color-green) 10%, var(--color-just-black)), color-mix(in srgb, var(--color-green) 10%, var(--color-just-black))) padding-box,
      var(--gradient-green) border-box;
  }
</style>
