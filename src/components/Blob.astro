---
import { disciplines, type Discipline } from "../lib/disciplines";

type Props = { discipline: Discipline; seed?: number; class?: string; float?: boolean; [data: `data-${string}`]: string };
const { discipline, seed = 1, class: className, float = false, ...rest } = Astro.props;
const [c1, c2] = disciplines[discipline].blob;

function rand(s: number) {
  return () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
}
function blobPath(s: number, n = 7) {
  const r = rand(s * 9973 + 7);
  const pts = Array.from({ length: n }, (_, i) => {
    const a = (i / n) * Math.PI * 2 - Math.PI / 2;
    const rad = 62 + r() * 30;
    return [100 + Math.cos(a) * rad, 100 + Math.sin(a) * rad];
  });
  const p = (i: number) => pts[(i + n) % n];
  const f = (v: number) => v.toFixed(1);
  let d = `M${f(p(0)[0])},${f(p(0)[1])}`;
  for (let i = 0; i < n; i++) {
    const [p0, p1, p2, p3] = [p(i - 1), p(i), p(i + 1), p(i + 2)];
    d += `C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
  }
  return d + "Z";
}

const id = `blob-${discipline}-${seed}-${Math.random().toString(36).slice(2, 7)}`;
const shape = blobPath(seed);
const morph = [blobPath(seed + 101), blobPath(seed + 202)].join("|");
---

<svg
  viewBox="0 0 200 200"
  aria-hidden="true"
  class:list={["blob block overflow-visible", className]}
  data-blob={float ? "float" : ""}
  data-discipline={discipline}
  {...rest}
>
  <defs>
    <radialGradient id={`${id}-fill`} cx="32%" cy="30%" r="78%">
      <stop offset="0%" stop-color={c2}></stop>
      <stop offset="55%" stop-color={c1}></stop>
      <stop offset="100%" stop-color={c1}></stop>
    </radialGradient>
    <radialGradient id={`${id}-shade`} cx="30%" cy="28%" r="85%">
      <stop offset="55%" stop-color="#0e100f" stop-opacity="0"></stop>
      <stop offset="100%" stop-color="#0e100f" stop-opacity="0.45"></stop>
    </radialGradient>
    <radialGradient id={`${id}-shine`} cx="34%" cy="30%" r="22%">
      <stop offset="0%" stop-color="#fffce1" stop-opacity="0.55"></stop>
      <stop offset="100%" stop-color="#fffce1" stop-opacity="0"></stop>
    </radialGradient>
    <path id={`${id}-path`} d={shape} data-morph={morph}></path>
  </defs>
  <use href={`#${id}-path`} fill={`url(#${id}-fill)`}></use>
  <use href={`#${id}-path`} fill={`url(#${id}-shade)`}></use>
  <use href={`#${id}-path`} fill={`url(#${id}-shine)`}></use>
</svg>
