---
import Pill from "./Pill.astro";
import { site } from "../lib/site";
---

<header id="nav" class="nav sticky top-0 z-50 transition-[background-color,border-color] duration-300">
  <nav aria-label="Main" class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-4 md:px-8">
    <a href="/" class="text-[20px] font-semibold tracking-[-0.01em] text-green">{site.name}</a>
    <div class="flex items-center gap-2 md:gap-8">
      <a href="/work" class="hidden py-2.5 text-body-sm text-cream/80 transition-colors hover:text-cream md:block">Work</a>
      <a href="/#about" class="hidden py-2.5 text-body-sm text-cream/80 transition-colors hover:text-cream md:block">About</a>
      <Pill href="/contact" variant="gradient" class="py-3! text-[16px]!">Start a project</Pill>
    </div>
  </nav>
</header>

<style>
  .nav {
    border-bottom: 1px solid transparent;
  }
  .nav[data-scrolled] {
    background: color-mix(in srgb, var(--color-just-black) 90%, transparent);
    border-bottom-color: var(--color-hairline);
  }
</style>

<script>
  const nav = document.getElementById("nav")!;
  const update = () => nav.toggleAttribute("data-scrolled", window.scrollY > 8);
  update();
  addEventListener("scroll", update, { passive: true });
</script>
